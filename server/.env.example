# PostgreSQL connection for the server
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/spendproof?schema=public"

# Replace with a long, random secret before running the server
JWT_SECRET="replace-with-a-long-random-secret"

# This email becomes the first administrator account on registration
ADMIN_EMAIL="admin@example.com"

# Local API configuration
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,https://localhost"
UPLOAD_DIR="uploads"
